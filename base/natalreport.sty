function M.override(lang,category,body,key,text)
 local o=M.overrides[lang];o[category]=o[category] or {};o[category][body]=o[category][body] or {}
 o[category][body][key]={text=text,raw=true}
end
function M.lookup(lang,category,body,key)
 local o=M.overrides[lang][category]
 if o and o[body] and o[body][tostring(key)] then return o[body][tostring(key)] end
 local b=M.banks[lang];local t=b and b[category]
 if body~="" then t=t and t[body] end
 return t and t[key]
end
return M
end

