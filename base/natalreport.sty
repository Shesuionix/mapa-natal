% =========================================================
% PARÂMETROS (sobrescreva com \renewcommand no preâmbulo)
% =========================================================
\providecommand{\BorderColor}{black}
\providecommand{\BorderLineWidth}{0.4pt}
\providecommand{\BorderStyle}{simple}
\providecommand{\BorderCornerStyle}{cross}
\providecommand{\BorderCornerSize}{0.5}
\providecommand{\BorderPageMargin}{.3}

% Chave de ativação automática (0 = desliga, 1 = liga)
\providecommand{\ShowPageBorder}{0}

% =========================================================
% CANTOS DECORATIVOS
% =========================================================
\newcommand{\AstroBorder@corners}[2]{%
	\IfStrEqCase{\BorderCornerStyle}{
		{cross}{%
			\pgfmathsetmacro{\@ab@s}{\BorderCornerSize}
			\foreach \sx in {-1, 1} {%
				\foreach \sy in {-1, 1} {%
					\pgfmathsetmacro{\@ab@xa}{\sx*(#1)}
					\pgfmathsetmacro{\@ab@ya}{\sy*(#2)}
					\pgfmathsetmacro{\@ab@xb}{\sx*(#1-\@ab@s)}
					\pgfmathsetmacro{\@ab@yb}{\sy*(#2-\@ab@s)}
					\draw[draw={\BorderColor}, line width={1.8\dimexpr\BorderLineWidth\relax}]
					(\@ab@xa, \@ab@ya) -- (\@ab@xb, \@ab@ya);
					\draw[draw={\BorderColor}, line width=\BorderLineWidth*1.8]
					(\@ab@xa, \@ab@ya) -- (\@ab@xa, \@ab@yb);
				}%
			}%
		}
		{square}{%
			\pgfmathsetmacro{\@ab@s}{\BorderCornerSize}
			\foreach \sx in {-1, 1} {%
				\foreach \sy in {-1, 1} {%
					\pgfmathsetmacro{\@ab@xa}{\sx*(#1)}
					\pgfmathsetmacro{\@ab@ya}{\sy*(#2)}
					\pgfmathsetmacro{\@ab@xb}{\sx*(#1-\@ab@s)}
					\pgfmathsetmacro{\@ab@yb}{\sy*(#2-\@ab@s)}
					\fill[fill={\BorderColor}]
					(\@ab@xa, \@ab@ya) rectangle
					(\@ab@xb, \@ab@yb);
				}%
			}%
		}
		{none}{}%
	}[]
}

% =========================================================
% ESTILOS DE BORDA
% =========================================================
\newcommand{\AstroBorder@simple}[2]{%
	\draw[draw={\BorderColor}, line width=\BorderLineWidth]
	(-#1, -#2) rectangle (#1, #2);
	\AstroBorder@corners{#1}{#2}
}

\newcommand{\AstroBorder@double}[2]{%
	\draw[draw={\BorderColor}, line width=\BorderLineWidth]
	(-#1, -#2) rectangle (#1, #2);
	\draw[draw={\BorderColor}, line width=\BorderLineWidth]
	(-#1+0.18, -#2+0.18) rectangle (#1-0.18, #2-0.18);
	\AstroBorder@corners{#1}{#2}
}

\newcommand{\AstroBorder@dashed}[2]{%
	\draw[draw={\BorderColor}, line width=\BorderLineWidth,
	dash pattern=on 4pt off 2pt]
	(-#1, -#2) rectangle (#1, #2);
	\AstroBorder@corners{#1}{#2}
}

\newcommand{\AstroBorder@draw}[2]{%
	\IfStrEqCase{\BorderStyle}{
		{simple}{\AstroBorder@simple{#1}{#2}}
		{double}{\AstroBorder@double{#1}{#2}}
		{dashed}{\AstroBorder@dashed{#1}{#2}}
	}[{\AstroBorder@simple{#1}{#2}}]
}

% =========================================================
% DESENHO DA BORDA (em coordenadas locais, sem tikzpicture)
% ---------------------------------------------------------
% Assume que (0,0) é o centro da página. Emite apenas os
% paths; não abre tikzpicture. Pode ser chamado de dentro de
% um tikzpicture existente.
% =========================================================
\newcommand{\AstroBorder@drawInPlace}[1]{%
	\pgfmathsetmacro{\@ab@w}{\paperwidth/2cm - #1}
	\pgfmathsetmacro{\@ab@h}{\paperheight/2cm - #1}
	\AstroBorder@draw{\@ab@w}{\@ab@h}
}

% =========================================================
% DESENHO DA BORDA NA PÁGINA (abre tikzpicture próprio)
% =========================================================
\newcommand{\AstroBorder@drawPage}[1]{%
	\begin{tikzpicture}[remember picture, overlay]
		\begin{scope}[shift={(current page.center)}]
			\AstroBorder@drawInPlace{#1}%
		\end{scope}
	\end{tikzpicture}%
}

% =========================================================
% COMANDO PÚBLICO: \DrawPageBorder
% ---------------------------------------------------------
% Desenha a borda da página na página corrente, SEMPRE.
% Não é mais condicionado por \ShowPageBorder.
%   \DrawPageBorder        % margem \BorderPageMargin
%   \DrawPageBorder[2]     % margem de 2 cm
% =========================================================
\newcommand{\DrawPageBorder}[1][\BorderPageMargin]{%
	\AstroBorder@drawPage{#1}%
}

% =========================================================
% INTEGRAÇÃO AUTOMÁTICA COM TODA PÁGINA
% ---------------------------------------------------------
% Usa o hook `shipout/background` (LaTeX 2020+) para
% desenhar a borda em todas as páginas enquanto
% \ShowPageBorder for 1. NÃO afeta \DrawPageBorder.
% =========================================================
\AddToHook{shipout/background}{%
	\ifnum\ShowPageBorder=1\relax
	\AstroBorder@drawPage{\BorderPageMargin}%
	\fi
}

