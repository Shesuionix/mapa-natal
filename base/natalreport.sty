local function parseConfig(s)
	local p = {}
	for k, v in pairs(DEFAULTS) do p[k] = v end
	if s and s ~= "" then
		for pair in s:gmatch("([^|]+)") do
			local k, v = pair:match("^(.-)=(.*)$")
			if not k or DEFAULTS[k] == nil then fail("Chave de config desconhecida: "..tostring(k or pair)) end
      v = v:gsub("%%(%x%x)", function(h) return string.char(tonumber(h,16)) end)
      if v:find("[\\{}%[%],;%%#|=]") then fail("Caractere reservado na config "..k) end
      p[k] = v
		end
	end

  for k,v in pairs(p) do
    if k:match("^show_") then
      v = v:lower():match("^%s*(.-)%s*$")
      if v ~= "true" and v ~= "false" and v ~= "1" and v ~= "0" and v ~= "yes" and v ~= "no" then fail("Booleano invalido: "..k) end
      p[k] = v
    end
  end
  for _,k in ipairs({"rotate","scale","xshift","yshift","aspect_opacity"}) do
    local n = tonumber(p[k])
    if not finite(n) or math.abs(n) > 100000 then fail("Numero invalido: "..k) end
    if k == "scale" and n <= 0 then fail("scale deve ser positivo") end
    if k == "aspect_opacity" and (n < 0 or n > 1) then fail("opacity fora de 0..1") end
  end
  return p
end

function M.encodeConfig(p)
  local out={}
  for k,v in pairs(p) do
    out[#out+1]=k.."="..tostring(v):gsub("[%%|=]", function(c) return string.format("%%%02X",string.byte(c)) end)
  end
  table.sort(out)
  return table.concat(out,"|")
end

-- Helpers para construir strings TikZ de opções
local function opts(...)
	local t = {}
	for i = 1, select("#", ...) do
    local x = select(i, ...)
		if x and x ~= "" then t[#t + 1] = x end
	end
	return "[" .. table.concat(t, ", ") .. "]"
end

