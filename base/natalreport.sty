 local h=lang=="pt" and {"Corpo","Signo","Grau","Casa","Mov.","Dignidade"} or {"Body","Sign","Degree","House","Motion","Dignity"}
 local b={tableOpen("@{}llrcrl@{}",h)}
 for i,key in ipairs(S.bodies) do local p=r.placements[key]
  b[#b+1]=table.concat({M.esc(M.body(key,lang)),M.esc(M.sign(p.sign,lang)),M.degree(p.longitude),p.house,p.movement,M.dignity(key,p.sign,lang)}," & ").."\\\\"
 end
 b[#b+1]="\\multicolumn{6}{l}{\\footnotesize "..(lang=="pt" and "D: direto; R: retrógrado; ?: movimento não informado." or "D: direct; R: retrograde; ?: motion not supplied.").."}\\\\"
 return finish(b)
end
function M.houses(d,r,lang)
 local b={tableOpen("@{}clrl@{}",lang=="pt" and {"Casa","Signo","Cúspide","Regente clássico"} or {"House","Sign","Cusp","Classical ruler"})}
 for i=1,12 do local si=S.signIndex(d.houses[i])
  b[#b+1]=table.concat({i,M.esc(M.sign(si,lang)),M.degree(d.houses[i]),M.esc(M.body(L.rulers[si],lang))}," & ").."\\\\"
 end
 return finish(b)
end
function M.aspects(d,r,lang,cfg)
 if #d.aspects==0 then return lang=="pt" and "Nenhum aspecto informado.\\par" or "No aspects supplied.\\par" end
 for _,color in ipairs({cfg.applying,cfg.separating}) do if not color:match("^[%w!%.%-]+$") then error("Cor de aspecto inválida",0) end end
 local palette="\\colorlet{NatalAspectApplying}{"..cfg.applying.."}\\colorlet{NatalAspectSeparating}{"..cfg.separating.."}\\colorlet{NatalAspectUnspecified}{gray!70}"
 local b={palette,tableOpen("@{}lllrl@{}",lang=="pt" and {"Corpo 1","Aspecto","Corpo 2","Orbe","Estado"} or {"Body 1","Aspect","Body 2","Orb","State"})}
 for _,a in ipairs(d.aspects) do
  local color=a.state=="Unspecified" and "NatalAspectUnspecified" or (a.state=="Applying" and "NatalAspectApplying" or "NatalAspectSeparating")
  if not color:match("^[%w!%.%-]+$") then error("Cor de aspecto inválida",0) end
  local state=a.state=="Unspecified" and (lang=="pt" and "Não informado" or "Not supplied") or (lang=="pt" and (a.state=="Applying" and "Aplicativo" or "Separativo") or a.state)
  b[#b+1]="\\rowcolor{"..color.."!8}"..table.concat({M.esc(M.body(a.body1,lang)),M.esc(lang=="pt" and (S.ptAspects[a.type] or a.type) or a.type),M.esc(M.body(a.body2,lang)),M.degree(a.orb,true),state}," & ").."\\\\"
 end
 return finish(b)
end
return M
end

