local function normalizeName(s)
	if not s then return nil end
	s = s:gsub("Á","a"):gsub("á","a"):gsub("É","e"):gsub("é","e"):gsub("Í","i"):gsub("í","i"):gsub("Ó","o"):gsub("ó","o"):gsub("ã","a"):gsub("â","a"):gsub("ê","e"):gsub("ú","u"):gsub("ç","c")
  s = s:lower()
	s = s:gsub("^%s+", ""):gsub("%s+$", "")
	s = s:gsub("[%s_%-]", "")
	local aliases = {
		sun="Sun", moon="Moon", mercury="Mercury", venus="Venus",
		mars="Mars", jupiter="Jupiter", saturn="Saturn", uranus="Uranus",
		neptune="Neptune", pluto="Pluto",
		node="Node", northnode="Node", ascendingnode="Node",
		southnode="SouthNode", descendingnode="SouthNode",
		chiron="Chiron", lilith="Lilith", blackmoon="Lilith",
		fortune="Fortune", vertex="Vertex",
		asc="Ascendant", ascendant="Ascendant",
