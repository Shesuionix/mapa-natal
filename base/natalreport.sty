local function fail(msg)
  texio.write_nl("term and log", "[astrocalc] ERRO: "..tostring(msg))
  error("astropack: "..tostring(msg), 0)
end

local function finite(n)
  return type(n) == "number" and n == n and math.abs(n) < math.huge
end

local function escapeText(s)
  local t = { ["\\"]="\\textbackslash{}", ["{"]="\\{", ["}"]="\\}",
    ["#"]="\\#", ["$"]="\\$", ["%"]="\\%", ["&"]="\\&", ["_"]="\\_",
    ["^"]="\\textasciicircum{}", ["~"]="\\textasciitilde{}", ["|"]="\\textbar{}" }
  return (s:gsub("[\\{}#$%%&_~^|]", t))
end

function M.setParameter(key, value)
  local n=tonumber(value)
  local allowed={SEP_MIN=true,FATOR_INTENSIDADE=true,TOLERANCIA=true,MAX_ITERACOES=true}
  if not allowed[key] or not finite(n) or n<=0 then fail("Parametro numerico invalido: "..tostring(key)) end
  M[key]=n
end

