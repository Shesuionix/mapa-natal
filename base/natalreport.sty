}%
}

% =========================================================
% [v1.9.1] SANEAMENTO DE OPÇÕES — remove espaços em branco
% ---------------------------------------------------------
% O usuário pode escrever as opções indentadas:
%     \CreateAstroChart*[
%         radius=4,
%         line color=blue,
%     ]{...}{...}{...}
%
% Os tabs/newlines se transformam em espaços residuais antes
% das chaves. O pgfkeys não os remove de forma confiável.
% Aqui removemos espaços em torno de `,` e `=`, e nas pontas.
% Usamos l3regex (parte do expl3, no kernel desde 2020).
% =========================================================
\ExplSyntaxOn
\cs_new_protected:Npn \astro_parse_opts:n #1 {
\tl_set:Nn \l_tmpa_tl { #1 }
\tl_trim_spaces:N \l_tmpa_tl
\exp_args:NV \pgfkeys \l_tmpa_tl
}
% Alias sem `_` e `:` para poder ser chamado fora do ExplSyntaxOn
\cs_set_eq:NN \AstroParseOpts \astro_parse_opts:n
\ExplSyntaxOff

