 en={report="Natal chart report",chart="Natal chart",technical="Technical data",planets="Planetary positions",houses="House cusps",aspects="Aspects",interpretations="Planetary interpretations",angles="Axes and angles",dominants="Patterns and dominants",synthesis="Final synthesis",glossary="Glossary",house="House",ruler="Classical ruler",none="No major aspect supplied for this body.",fire="Fire",earth="Earth",air="Air",water="Water",cardinal="Cardinal",fixed="Fixed",mutable="Mutable",east="Eastern",west="Western",north="Below the horizon",south="Above the horizon",elements="Elements",modalities="Modalities",hemispheres="Hemispheres",patterns="Configurations and stelliums"}
}
local patternNames={pt={stellium_sign="Stellium por signo",stellium_house="Stellium por casa",t_square="T-quadrado",grand_trine="Grande trígono",yod="Yod",grand_cross="Grande cruz"},
 en={stellium_sign="Sign stellium",stellium_house="House stellium",t_square="T-square",grand_trine="Grand trine",yod="Yod",grand_cross="Grand cross"}}
local function para(text) return (E(text):gsub("\n\n+","\\par\\medskip\n")).."\\par\\medskip\n" end
local function text(c,category,body,key,description,vars)
 local v=X.lookup(c.lang,category,body,key)
 if not v then
  local sig=category..":"..body..":"..tostring(key)
  if not c.missing[sig] then c.missing[sig]=true;c.warnings[#c.warnings+1]="Texto ausente: "..(description or sig) end
  return para("["..(c.lang=="pt" and "texto ausente: " or "missing text: ")..(description or sig).."]")
 end
 if type(v)=="table" and v.raw then return v.text.."\\par\\medskip\n" end
 if vars then v=v:gsub("{([a-z_]+)}",function(k)return vars[k] or ("{"..k.."}")end) end
 return para(v)
end
local function heading(c,key,override) return "\\section*{"..E(override or c.ui[key]).."}\n" end
local function subheading(s) return "\\subsection*{"..E(s).."}\n" end
local function named(c,key) return T.body(key,c.lang) end
local sections={}
function sections.cover(c,title)
 local d=c.d;local b={"\\begin{titlepage}\\centering\\vspace*{1cm}", "{\\Large "..E(title or c.ui.report).."}\\par\\vspace{1.2cm}",
 "{\\Huge\\bfseries "..E(d.nome).."}\\par\\vspace{0.8cm}","{\\large "..E(d.data.." — "..d.hora.." "..d.fuso).."}\\par\\medskip",E(d["local"]).."\\par\\medskip"}
 local lat=d.lat and string.format("%.4f",d.lat) or (c.lang=="pt" and "não informada" or "not supplied")
 local lon=d.lon and string.format("%.4f",d.lon) or (c.lang=="pt" and "não informada" or "not supplied")
 b[#b+1]=E("Latitude: "..lat.."; Longitude: "..lon).."\\par"
 b[#b+1]=E(d.casas).."\\par\\vfill"
 if c.cfg.cover_style=="minimal" then b[#b+1]="\\begin{tikzpicture}\\draw[blue!45,line width=1pt] (0,0) circle (1.2cm);\\draw[blue!25] (0,0) circle (1cm);\\draw[blue!45] (-1.4,0)--(1.4,0) (0,-1.4)--(0,1.4);\\end{tikzpicture}\\par\\vfill" end
 if d.tema~="" then b[#b+1]="\\textbf{"..E(d.tema).."}\\par\\medskip" end
 b[#b+1]="{\\small "..E(c.lang=="pt" and "Leitura simbólica para reflexão pessoal. As posições são fornecidas pelo usuário; este pacote não calcula efemérides." or "A symbolic reading for personal reflection. Positions are supplied by the user; this package does not calculate ephemerides.").."}\\end{titlepage}"
 return table.concat(b,"\n")
end
function sections.chart(c,title)
 local planets,houses,aspects={},{},{}
 for i=1,15 do planets[i]=string.format("%.10f",c.d.planets[i]) end
 for i=1,12 do houses[i]=string.format("%.10f",c.d.houses[i]) end
 local unclassified=#c.d.aspects>0 and c.d.aspects[1].state=="Unspecified"
 for _,a in ipairs(c.d.aspects) do
  if unclassified then aspects[#aspects+1]="{"..a.body1..","..a.body2.."}"
  else aspects[#aspects+1]=string.format("%s %s %s (Orb: %d°%02d', %s)",a.body1,a.type,a.body2,math.floor(math.floor(a.orb*60+0.5)/60),math.floor(a.orb*60+0.5)%60,a.state) end
 end
 -- Local TeX macros keep each invocation independent and preserve the chart pipeline.
 local out=heading(c,"chart",title)
 out=out.."\\def\\NatalPlanetsCSV{"..table.concat(planets,",").."}\\def\\NatalHousesCSV{"..table.concat(houses,",").."}\\def\\NatalAspectsText{"..table.concat(aspects,", ").."}\n"
 if unclassified then out=out.."\\begingroup\\renewcommand{\\AspectApplyingColor}{gray!70}\\NatalChartInternal\\endgroup "
 else out=out.."\\NatalChartInternal " end
 out=out.."\\begin{center}\\small "..E(c.ui.chart.." — "..c.d.nome.." — "..c.d.data).."\\end{center}\n"
 if unclassified then out=out..para(c.lang=="pt" and "Aspectos em cinza: os estados aplicativo e separativo não foram informados na fonte. As posições e cúspides foram preservadas, sem recálculo." or "Gray aspects: applying and separating states were not supplied in the source. Positions and cusps are preserved without recalculation.") end
 return out
end
function sections.planet_table(c,title) return subheading(title or c.ui.planets)..T.planets(c.d,c.r,c.lang) end
function sections.house_table(c,title) return subheading(title or c.ui.houses)..T.houses(c.d,c.r,c.lang) end
function sections.aspect_table(c,title)
 local reserve=""
 if #c.d.aspects>0 and #c.d.aspects<=12 then
  reserve="\\par\\begingroup\\ifdim\\dimexpr\\pagegoal-\\pagetotal\\relax<"..((#c.d.aspects+5)*15).."pt\\newpage\\fi\\endgroup "
 end
 return reserve..subheading(title or c.ui.aspects)..T.aspects(c.d,c.r,c.lang,c.cfg)
end
function sections.technical(c,title)
 return "\\clearpage "..heading(c,"technical",title)..sections.planet_table(c)..sections.house_table(c)..sections.aspect_table(c)
end
function sections.interpretations(c,title)
 local b={heading(c,"interpretations",title)}
 local major={Conjunction=true,Sextile=true,Square=true,Trine=true,Opposition=true}
 for i,key in ipairs(S.bodies) do
  local p=c.r.placements[key];local sign=S.signs[p.sign]
  b[#b+1]="\\subsection*{{\\astrofont "..S.symbols[i].."} "..E(named(c,key)).."}"
  b[#b+1]="\\textbf{"..E(T.sign(p.sign,c.lang).." "..T.degree(p.longitude).." — "..c.ui.house.." "..p.house).."}\\par\\medskip"
  b[#b+1]=text(c,"planet_in_sign",key,sign,named(c,key).." "..T.sign(p.sign,c.lang))
  b[#b+1]=text(c,"planet_in_house",key,p.house,named(c,key).." "..c.ui.house.." "..p.house)
  local found=false
  for _,a in ipairs(c.d.aspects) do if major[a.type] and (a.body1==key or a.body2==key) then
   found=true
   local other=a.body1==key and a.body2 or a.body1
   b[#b+1]="\\textit{"..E(named(c,other).." — "..(c.lang=="pt" and (S.ptAspects[a.type] or a.type) or a.type).." — "..T.degree(a.orb,true)).."}\\par"
   local pair=key.."-"..a.type.."-"..other
   if X.banks[c.lang].aspect[pair] then b[#b+1]=text(c,"aspect","",pair)
   else b[#b+1]=text(c,"aspect_generic","",a.type) end
  end end
  if not found then b[#b+1]="{\\small "..E(c.ui.none).."}\\par\\medskip" end
 end
 return table.concat(b,"\n")
end
function sections.angles(c,title)
 local b={heading(c,"angles",title)}
 for _,key in ipairs({"Ascendant","MC","DSC","IC","Node","SouthNode","Lilith","Chiron","Fortune","Vertex"}) do
  local n=c.r.angles[key];local si=S.signIndex(n)
  b[#b+1]=subheading(named(c,key).." — "..T.sign(si,c.lang).." "..T.degree(n))
  if key=="Ascendant" or key=="MC" or key=="DSC" or key=="IC" then
   b[#b+1]=E(c.ui.ruler..": "..named(c,L.rulers[si])).."\\par\\medskip"
   b[#b+1]=text(c,"angle",key,S.signs[si])
  else b[#b+1]=text(c,"angle",key,S.signs[si]) end
 end
 return table.concat(b,"\n")
end
local function bars(c,title,values,order,denominator)
 local b={subheading(title),"\\begin{tabular}{@{}lrl@{}}"}
 for _,key in ipairs(order) do
  local n=values[key];local percent=100*n/denominator
  b[#b+1]=string.format("%s & %d (%.0f\\%%) & \\begin{tikzpicture}[baseline=-.5ex]\\fill[blue!65] (0,0) rectangle (%.3fcm,.16cm);\\end{tikzpicture}\\\\",E(c.ui[key]),n,percent,percent/100*4)
 end
 b[#b+1]="\\end{tabular}\\par\\medskip"
 return table.concat(b,"\n")
end
function sections.dominants(c,title)
 local r=c.r
 local b={heading(c,"dominants",title),para(c.lang=="pt" and "Contagens dos dez corpos de Sol a Plutão, com peso igual. Pontos, nodos e Quíron não entram em dominâncias ou configurações; os 15 corpos permanecem nas tabelas e interpretações." or "Counts use the ten bodies from Sun through Pluto with equal weight. Points, nodes and Chiron are excluded from dominants and configurations; all fifteen remain in tables and interpretations."),
 bars(c,c.ui.elements,r.elements,{"fire","earth","air","water"},10),
 bars(c,c.ui.modalities,r.modalities,{"cardinal","fixed","mutable"},10),
 bars(c,c.ui.hemispheres,r.hemispheres,{"east","west","north","south"},10)}
 for _,p in ipairs(r.dominants) do b[#b+1]=text(c,"dominant","",p.chave_de_texto) end
 b[#b+1]=subheading(c.ui.patterns)
 for _,p in ipairs(r.patterns) do
  local names={};for _,key in ipairs(p.membros) do names[#names+1]=named(c,key) end
  local context=p.tipo=="stellium_sign" and T.sign(p.context,c.lang) or (p.tipo=="stellium_house" and c.ui.house.." "..p.context or "")
  b[#b+1]="\\textbf{"..E(patternNames[c.lang][p.tipo]..(context~="" and " — "..context or "")).."}\\par\\nobreak "..E(table.concat(names,", ")).."\\par\\nobreak\\medskip"
  b[#b+1]=text(c,"dominant","",p.chave_de_texto)
 end
 if #r.patterns==0 then b[#b+1]=text(c,"dominant","","no_configuration") end
 return table.concat(b,"\n")
end
function sections.synthesis(c,title)
 local b={"\\clearpage ",heading(c,"synthesis",title),text(c,"synthesis","","default")}
 local si=S.signIndex(c.r.angles.Ascendant)
 local dom,patterns,seen={},{},{}
 for _,p in ipairs(c.r.dominants) do local key=p.tipo:match("_([a-z]+)$");dom[#dom+1]=c.ui[key] or key end
 for _,p in ipairs(c.r.patterns) do if not seen[p.tipo] then seen[p.tipo]=true;patterns[#patterns+1]=patternNames[c.lang][p.tipo] end end
 if #patterns==0 then patterns[1]=c.lang=="pt" and "nenhuma na lista fornecida" or "none in the supplied list" end
 b[#b+1]=text(c,"synthesis","","integration",nil,{sun=T.sign(c.r.placements.Sun.sign,c.lang),
 moon=T.sign(c.r.placements.Moon.sign,c.lang),asc=T.sign(si,c.lang),dominants=table.concat(dom,", "),patterns=table.concat(patterns,", ")})
 for _,p in ipairs(c.r.dominants) do b[#b+1]=text(c,"dominant","",p.chave_de_texto) end
 local summarized={}
 for _,p in ipairs(c.r.patterns) do
  if not summarized[p.tipo] then summarized[p.tipo]=true;b[#b+1]=text(c,"dominant","",p.chave_de_texto) end
 end
 if c.d.observacoes~="" then b[#b+1]=para(c.d.observacoes) end
 return table.concat(b,"\n")
end
function sections.glossary(c,title)
 local defs=c.lang=="pt" and {
 {"Signo","Estilo simbólico associado a um setor de 30 graus do zodíaco."},{"Casa","Campo de experiência delimitado pelas cúspides fornecidas."},{"Aspecto","Relação angular entre dois corpos ou pontos."},{"Orbe","Distância informada em relação ao ângulo exato do aspecto."},{"Aplicativo / separativo","Estado fornecido indicando aproximação ou afastamento da exatidão."},{"Stellium","Grupo de três ou mais dos dez planetas no mesmo signo ou casa."},{"Regente clássico","Planeta associado ao signo pelo esquema tradicional de sete regentes."},{"Dignidade","Relação tradicional entre planeta e signo; não mede valor pessoal nem garante resultados."}
 } or {
 {"Sign","A symbolic style associated with a thirty-degree sector of the zodiac."},{"House","An area of experience bounded by the supplied cusps."},{"Aspect","An angular relationship between two bodies or points."},{"Orb","The supplied distance from the exact aspect angle."},{"Applying / separating","The supplied state indicating approach to or departure from exactness."},{"Stellium","Three or more of the ten planets in one sign or house."},{"Classical ruler","The planet associated with a sign in the traditional seven-ruler scheme."},{"Dignity","A traditional planet-sign relationship, not a measure of personal worth or guaranteed outcomes."}}
 local b={"\\clearpage ",heading(c,"glossary",title),"\\begin{description}"}
 for _,v in ipairs(defs) do b[#b+1]="\\item["..E(v[1]).."] "..E(v[2]) end
 b[#b+1]="\\end{description}";return table.concat(b,"\n")
end
local function context(cfg)
 if not D.current then error("Dados ausentes. Use SetNatalData ou LoadNatalData antes do relatório.",0) end
 if cfg.idioma~="pt" and cfg.idioma~="en" then error("idioma deve ser pt ou en",0) end
 if cfg.cover_style~="minimal" and cfg.cover_style~="plain" then error("cover style deve ser minimal ou plain",0) end
 for _,k in ipairs({"cover","technical","interpretations","dominants","synthesis","glossary"}) do if cfg[k]~="true" and cfg[k]~="false" then error("Booleano inválido: "..k.."; use true ou false.",0) end end
 local c={d=D.current,r=L.analyze(D.current),cfg=cfg,lang=cfg.idioma,ui=labels[cfg.idioma],warnings={},missing={}}
 for _,w in ipairs(D.current.warnings or {}) do c.warnings[#c.warnings+1]=w end
 if X.versao<"0.1.0" then c.warnings[#c.warnings+1]="Banco de textos anterior a 0.1.0" end
 if D.current.reference and (D.current.lat==nil or D.current.lon==nil) then
  c.warnings[#c.warnings+1]="Importacao de referencia: coordenadas ausentes; cuspides fornecidas preservadas"
 end
 return c
end
local function warnings(c)
 local b={}
 for _,w in ipairs(c.warnings) do
  texio.write_nl("term and log","[natalreport] "..w)
  b[#b+1]="\\PackageWarning{natalreport}{"..E(w).."}"
 end
 return table.concat(b,"\n")
end
function M.run(section,cfg,title)
 if title=="" then title=nil end
 local c=context(cfg);local b={}
 if section=="report" then
  if cfg.cover=="true" then b[#b+1]=sections.cover(c) end
  b[#b+1]=sections.chart(c)
  if cfg.technical=="true" then b[#b+1]=sections.technical(c) end
  if cfg.interpretations=="true" then b[#b+1]=sections.interpretations(c) end
  b[#b+1]=sections.angles(c)
  if cfg.dominants=="true" then b[#b+1]=sections.dominants(c) end
  if cfg.synthesis=="true" then b[#b+1]=sections.synthesis(c) end
  if cfg.glossary=="true" then b[#b+1]=sections.glossary(c) end
 elseif section=="dryrun" then
  -- Walk every interpretation and section so diagnostics include hidden sections.
  for _,k in ipairs({"interpretations","angles","dominants","synthesis"}) do sections[k](c) end
  local states={Applying=0,Separating=0,Unspecified=0};for _,a in ipairs(c.d.aspects) do states[a.state]=states[a.state]+1 end
  texio.write_nl("term and log",string.format("[NatalDryRun] planets=%d houses=%d aspects=%d Applying=%d Separating=%d Unspecified=%d patterns=%d",#c.d.planets,#c.d.houses,#c.d.aspects,states.Applying,states.Separating,states.Unspecified,#c.r.patterns))
  for _,p in ipairs(c.r.patterns) do texio.write_nl("log","[NatalDryRun] pattern="..p.tipo.." members="..table.concat(p.membros,",")) end
  local n=0;for _ in pairs(c.missing) do n=n+1 end
  texio.write_nl("term and log","[NatalDryRun] missing_texts="..n)
 else
  if not sections[section] then error("Seção desconhecida: "..tostring(section),0) end
  b[#b+1]=sections[section](c,title)
 end
 local emitted=(warnings(c)..table.concat(b,"\n")):gsub("[\r\n]+"," ")
 tex.sprint(emitted)
end
function M.call(method,...)
 local fn=({set=D.set,setReference=D.setReference,load=D.load,loadReference=D.loadReference,override=X.override,run=M.run})[method]
 local ok,err=pcall(fn,...)
 if not ok then
  texio.write_nl("term and log","[natalreport] ERROR: "..tostring(err))
  tex.sprint("\\PackageError{natalreport}{"..E(err).."}{Corrija o campo e consulte README.md.}")
 end
end
return M
end

