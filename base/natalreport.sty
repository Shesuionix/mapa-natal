local function stripBOM(s)
	if not s then return s end
	return (s:gsub("^\239\187\191", ""))
end

local function parseToTable(s)
	if not s then return nil end
	s = stripBOM(s)
	local out = {}
  if s:match("^%s*,") or s:match(",%s*,") or s:match(",%s*$") then fail("CSV contem campo vazio") end
	for token in s:gmatch("([^,]+)") do
		local t = token:match("^%s*(.-)%s*$")
		if t ~= "" then
			local n = tonumber(t)
			if not finite(n) then
				fail("parseToTable: token inválido '"..t.."'")
				return nil
			end
			out[#out + 1] = n
		end
	end
	return out
end

local cache_signNames = {}
local cache_symbols   = {}

local function parseSignNames(s)
	if cache_signNames[s] then return cache_signNames[s] end
	local out = {}
	for name in (s .. ","):gmatch("([^,]+),") do
		out[#out + 1] = name:gsub("^%s+", ""):gsub("%s+$", "")
	end
	cache_signNames[s] = out
	return out
end

local function parseSymbols(s)
	if cache_symbols[s] then return cache_symbols[s] end
	local out = {}
	for sym in s:gmatch("{(.-)}") do
		out[#out + 1] = sym
	end
	cache_symbols[s] = out
	return out
end

local function distancia_direcional(a, b)
	return (a - b + 180) % 360 - 180
end

-- =========================================================
-- REPULSÃO ITERATIVA
-- =========================================================
local function redistribuir(ang, n, sep_min)
	if n <= 1 then return end
  if not finite(sep_min) or sep_min <= 0 or not finite(M.FATOR_INTENSIDADE) or M.FATOR_INTENSIDADE <= 0 or not finite(M.TOLERANCIA) or M.TOLERANCIA <= 0 or not finite(M.MAX_ITERACOES) or M.MAX_ITERACOES < 1 then fail("Parametros de repulsao invalidos") end
  local started = os.clock()
  local limit = math.min(math.floor(M.MAX_ITERACOES), 10000)
	if n * sep_min > 360 then
		warn("redistribuir: separacao minima impossivel; distribuicao uniforme")
		for i = 1, n do ang[i] = (i-1) * 360.0 / n end
		return
	end
	for i = 1, n do
		ang[i] = ang[i] % 360
		if ang[i] < 0 then ang[i] = ang[i] + 360 end
	end

	local convergido, iter = false, 0
	while (not convergido) and (iter < limit) and (os.clock() - started < 0.5) do
		local desloc = {}
		for i = 1, n do desloc[i] = 0.0 end
		for i = 1, n do
			for j = i + 1, n do
				local dd   = distancia_direcional(ang[i], ang[j])
				local dist = math.abs(dd)
				if dist < sep_min then
					local sobreposicao = sep_min - dist
					local forca = sobreposicao * M.FATOR_INTENSIDADE * 0.5
					if dd > 0 then
						desloc[i] = desloc[i] + forca
						desloc[j] = desloc[j] - forca
					else
						desloc[i] = desloc[i] - forca
						desloc[j] = desloc[j] + forca
					end
				end
			end
		end
		local damping = 1.0 / (1.0 + iter * 0.001)
		local maior = 0.0
		for i = 1, n do
			local d = desloc[i] * damping
			ang[i] = (ang[i] + d) % 360
			if ang[i] < 0 then ang[i] = ang[i] + 360 end
			if math.abs(d) > maior then maior = math.abs(d) end
		end
		if maior < M.TOLERANCIA then
      -- Não confundir estagnação com separação efetiva.
      local gap = 360
      for i=1,n-1 do for j=i+1,n do gap=math.min(gap, math.abs(distancia_direcional(ang[i],ang[j]))) end end
      if gap < sep_min * 0.999 then warn("redistribuir: estagnou antes da separacao minima") end
			convergido = true
		else
			local separado = true
			for i = 1, n - 1 do
				if not separado then break end
				for j = i + 1, n do
					if math.abs(distancia_direcional(ang[i], ang[j])) < sep_min * 0.999 then
						separado = false
						break
					end
				end
			end
			if separado then convergido = true end
		end
		iter = iter + 1
	end
	if not convergido then
		warn(string.format(
			"redistribuir: NÃO convergiu após %d iterações (n=%d, sep_min=%.2f)",
			iter, n, sep_min))
	end
end

