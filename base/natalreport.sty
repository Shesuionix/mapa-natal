-- =========================================================
-- PARSERS DE ENTRADA
-- =========================================================
local function parsePlanetText(text)
	text = stripBOM(text):gsub(" em ", " in ")
	local posicoes = {}
  local pattern="("..LETRA_MAIS..")%s+in%s+(" .. LETRA_MAIS .. ")%s+(%d+)°(%d*)"
  local residue=text:gsub(pattern,""):gsub("′",""):gsub("[,%s;']","")
  if residue~="" then fail("Texto planetario fora da gramatica: "..residue) end
	for planeta, signo, gr, mn in text:gmatch(pattern) do
		local key = normalizeName(planeta)
		if key and key ~= "Ascendant" and key ~= "MC"
		and key ~= "IC" and key ~= "DSC" then
			local base = mapaSignos[signo]
      if not BODY_MAP[key] or BODY_MAP[key] < 1 then fail("Corpo desconhecido: "..planeta) end
      if posicoes[key] then fail("Corpo duplicado: "..planeta) end
			if not base then
				fail("Signo desconhecido em parsePlanetText: " .. tostring(signo))
			else
				gr = tonumber(gr) or 0
				mn = tonumber(mn) or 0
				if gr > 29 or mn > 59 then fail("Grau/minuto fora do signo: "..planeta) end
        posicoes[key] = base + gr + mn / 60.0
			end
		end
	end
	local partes, faltando = {}, {}
	for i, nome in ipairs(ORDEM_PLANETAS) do
		if posicoes[nome] then
			partes[i] = posicoes[nome]
		else
			partes[i] = 0
			faltando[#faltando + 1] = nome
		end
	end
	if #faltando > 0 then
		fail("Planetas ausentes: " .. table.concat(faltando, ", "))
	end
	return partes
end

local function parseHouseText(text)
	text = stripBOM(text):gsub("Casa em ", "House in ")
	local previous = -1
	local partes, k = {}, 0
  local pattern="House%s+in%s+(" .. LETRA_MAIS .. ")%s+(%d+)°(%d*)"
  local residue=text:gsub(pattern,""):gsub("′",""):gsub("[,%s;']","")
  if residue~="" then fail("Texto de casas fora da gramatica: "..residue) end
	for signo, gr, mn in text:gmatch(pattern) do
		gr = tonumber(gr) or 0
		mn = tonumber(mn) or 0
		local base = mapaSignos[signo]
		if not base then
			fail("Signo desconhecido em parseHouseText: " .. tostring(signo))
		else
			if gr > 29 or mn > 59 then fail("Grau/minuto invalido na casa") end
      local raw = base + gr + mn / 60.0
			while raw <= previous do raw = raw + 360 end
			k = k + 1
			partes[k] = raw
			previous = raw
		end
	end
	if k == 0 then
		fail("parseHouseText: nenhuma casa reconhecida")
	end
	return partes
end

-- [v1.9.5] corrigido: o estado está entre parênteses no formato
-- canônico ("Corpo Aspecto Corpo (Applying)"). A versão anterior
-- exigia `[,%s]` antes do estado, o que falhava para `(Applying)`
-- e `(Separating)`. Agora aceitamos parêntese, vírgula ou
-- whitespace.
local function parseAspectChunk(chunk)
	chunk = chunk:gsub("^%s+", ""):gsub("%s+$", "")
	if chunk == "" then return nil end

	local state = chunk:match("[,(%s]+(%a+)%s*%)%s*$")
	if not state then warn("Aspecto invalido: use Corpo Aspecto Corpo (Orb: 1°00\', Applying|Separating)"); return nil end
	state = state:lower()
	state = state:sub(1,1):upper() .. state:sub(2)
  if state ~= "Applying" and state ~= "Separating" then warn("Estado de aspecto desconhecido: "..state); return nil end

	for _, asp in ipairs(M.ASPECT_NAMES) do
		local pattern = "%f[%a]" .. asp:gsub("([^%w])", "%%%1") .. "%f[%A]"
		local s, e = chunk:find(pattern)
		if s then
			local body1 = chunk:sub(1, s - 1):gsub("^%s+", ""):gsub("%s+$", "")
			local rest  = chunk:sub(e + 1)
			local body2 = rest:match("^(.-)%s*%(") or rest
			body2 = body2:gsub("^%s+", ""):gsub("%s+$", "")
			return body1, asp, body2, state
		end
	end
	warn("Aspecto nao reconhecido: "..chunk)
  return nil
end

local function parseAspectTextInternal(text)
	text = stripBOM(text)
	local applying, separating = {}, {}
  local residue = text:gsub("[^()]+%b()", ""):gsub("[,%s]", "")
  if residue ~= "" or (text:match("%S") and not text:find("(",1,true)) then warn("Aspectos fora do formato canonico foram ignorados") end
	for chunk in text:gmatch("[^()]+%b()") do
		chunk = chunk:gsub("^[,%s]+", "")
    local b1, asp, b2, state = parseAspectChunk(chunk)
		if b1 and b2 and state then
			local n1 = normalizeName(b1)
			local n2 = normalizeName(b2)
			if BODY_MAP[n1] or n1 == "SouthNode" then
        if not (BODY_MAP[n2] or n2 == "SouthNode") then warn("Corpo desconhecido: "..tostring(n2)) else
				local pair = "{" .. n1 .. "," .. n2 .. "}"
				if state == "Applying" then
					applying[#applying + 1] = pair
				elseif state == "Separating" then
					separating[#separating + 1] = pair
				end
        end
      else warn("Corpo desconhecido: "..tostring(n1))
			end
		end
	end
	log(string.format("parseAspectText: %d applying, %d separating",
		#applying, #separating))
	return table.concat(applying, ","), table.concat(separating, ",")
end

local function makeResolver(a, h)
	return function(nome)
		if not nome then return 0 end
		if nome == "SouthNode" then
			local node = a[BODY_MAP["Node"]]
			if node then return (node + 180) % 360 end
			return 0
		end
		local v = BODY_MAP[nome]
		if v == nil then
			warn("corpo desconhecido em aspecto: '"..tostring(nome).."'")
			return 0
		end
		if v > 0 and v <= 15 then return a[v] or 0 end
		if v < 0 then
			local hi = HOUSE_IDX[v]
			return (hi and h[hi]) or 0
		end
		return 0
	end
end

local function pairsToCoordinates(pairs, a, h)
	local resolver = makeResolver(a, h)
	local r = {}
  if pairs:match("%S") and not pairs:find("{",1,true) then warn("Aspecto ignorado: use pares {Sun,Moon} ou formato canonico com parenteses") end
	for pair in string.gmatch(pairs, "{(.-)}") do
		local p1, p2 = pair:match("^(.-)%s*,%s*(.-)$")
		if p1 and p2 then
			local n1 = normalizeName(p1)
			local n2 = normalizeName(p2)
			if (BODY_MAP[n1] or n1=="SouthNode") and (BODY_MAP[n2] or n2=="SouthNode") then
        r[#r + 1] = { resolver(n1), resolver(n2) }
      else warn("Par de aspecto ignorado: corpo desconhecido") end
		end
	end
	return r
end

-- =========================================================
-- CONSTRUÇÃO DO ESTADO
-- =========================================================
local function buildState(planets, houses, radius, signNamesStr,
                         zodiacSymbolsStr, astralSymbolsStr,
                         applyColor, sepColor, aspectsUseAdjusted,
                         cfgStr)
	local st = {}
	local r = radius

	st.params = parseConfig(cfgStr)

	st.linhai     = R.edge         * r
	st.linhaii    = R.cardinal     * r
	st.linhaiii   = R.zodiacOuter  * r
	st.linhaiv    = R.zodiacInner  * r
	st.linhav     = R.planetsOuter * r
	st.linhavi    = R.planetsInner * r
	st.linhavii   = R.housesOuter  * r
	st.linhaviii  = R.housesInner  * r
	st.linhaix    = R.aspects      * r
	st.linhax     = R.symbols      * r
	st.linhaxi    = R.connect      * r

	st.zodiacLabelRadius  = (st.linhaiii + st.linhaiv) / 2
	st.zodiacSymbolRadius = (st.linhaiii + st.linhaiv) / 3
	st.houseLabelRadius   = (st.linhavii + st.linhaviii) / 2

	st.houses         = houses
	-- [v1.9.2] rotationOffset inclui o offset base (180° para ASC
	-- à esquerda) E a rotação do usuário.
	local rotBase = 180 - houses[1]
	local rotUser = tonumber(st.params.rotate) or 0
	st.rotationOffset = rotBase + rotUser

	st.astral = {}
	for i = 1, 15 do st.astral[i] = planets[i] end

	st.astralAdjusted = {}
	for i = 1, 15 do st.astralAdjusted[i] = planets[i] end
	redistribuir(st.astralAdjusted, 15, M.SEP_MIN)

	st.signNames        = parseSignNames(signNamesStr)
	st.zodiacSymbols    = parseSymbols(zodiacSymbolsStr)
	st.astralSymbols    = parseSymbols(astralSymbolsStr)
	st.applyColor       = applyColor
	st.sepColor         = sepColor

	local s = tostring(aspectsUseAdjusted):lower()
	st.aspectsUseAdjusted = (s == "1" or s == "true" or s == "yes")

	if #st.astralSymbols ~= #st.astral then
		warn(string.format(
			"astralSymbols tem %d itens (esperado %d) — símbolos extras serão ignorados",
			#st.astralSymbols, #st.astral))
	end

	return st
end

-- =========================================================
-- EMISSORES
-- =========================================================

-- [v1.9.4] Fill do zodíaco contido entre as divisórias.
-- Cada signo ocupa 28° (de `angle+1` a `angle+29`); os 2°
-- restantes são consumidos pelas duas linhas da divisória.
-- Preenche cada setor individualmente (não o anel contínuo),
-- assim a cor não invade as divisórias nem os gaps.
local function emitZodiacFill(buf, st)
	local p = st.params
	if not is_true(p.show_zodiac) then return end
	if p.zodiac_fill == "none" then return end
	local rot = st.rotationOffset
	for i = 0, 11 do
		local a0 = i * 30 + rot + 1
		local a1 = i * 30 + rot + 29
		buf[#buf + 1] = string.format(
			"\\fill[%s] "
			.. "(%.2f:%.3f cm) "
			.. "arc[start angle=%.2f, end angle=%.2f, radius=%.3f cm] "
			.. "-- (%.2f:%.3f cm) "
			.. "arc[start angle=%.2f, end angle=%.2f, radius=%.3f cm] "
			.. "-- cycle;",
			p.zodiac_fill,
			a0, st.linhaiii,
			a0, a1, st.linhaiii,
			a1, st.linhaiv,
			a1, a0, st.linhaiv)
	end
end

local function emitConcentricCircles(buf, st)
	local p = st.params
	local radii = { st.linhaii, st.linhav, st.linhavii, st.linhaviii }
	local parts = {}
	for _, r in ipairs(radii) do
		parts[#parts + 1] = string.format("(0,0) circle (%.3f cm)", r)
	end
	buf[#buf + 1] = string.format("\\draw%s %s;",
		opts(width_opt(p.line_width), "draw=" .. p.line_color),
		table.concat(parts, " "))
end

-- [v1.9.2] ASC/DSC em coordenadas polares (baseadas em houses[1]).
local function upright(a)
  return (a + 90) % 180 - 90
end

local function emitCardinalAxes(buf, st)
	local p = st.params
	local mcAngle  = (st.houses[10] + st.rotationOffset) % 360
	local icAngle  = (st.houses[4] + st.rotationOffset) % 360
	local ascAngle = (st.houses[1]  + st.rotationOffset) % 360
	local dscAngle = (st.houses[7] + st.rotationOffset) % 360
	local o = opts(width_opt(p.axis_line_width), "draw=" .. p.line_color)
	local showLabels = is_true(p.show_axes_labels)

	local nMC, nIC, nDSC, nASC = "", "", "", ""
	if showLabels then
    local function label(angle, text)
      return string.format(" (%.2f:%.3f cm) node[inner sep=1pt, text=%s, rotate=%.2f] {\\scriptsize\\bfseries %s}",
        angle, st.linhai + 0.24, p.axis_label_color, upright(angle-90), text)
    end
    nMC, nIC = label(mcAngle,"MC"), label(icAngle,"IC")
    nDSC, nASC = label(dscAngle,"DSC"), label(ascAngle,"ASC")
	end

	buf[#buf + 1] = string.format(
		"\\draw%s (%.2f:%.3f cm)--(%.2f:%.3f cm)%s;",
		o, mcAngle, st.linhaii, mcAngle, st.linhai, nMC)

	buf[#buf + 1] = string.format(
		"\\draw%s (%.2f:%.3f cm)--(%.2f:%.3f cm)%s;",
		o, icAngle, st.linhaii, icAngle, st.linhai, nIC)

	buf[#buf + 1] = string.format(
		"\\draw%s (%.2f:%.3f cm)--(%.2f:%.3f cm)%s;",
		o, dscAngle, st.linhaii, dscAngle, st.linhai, nDSC)

	buf[#buf + 1] = string.format(
		"\\draw%s (%.2f:%.3f cm)--(%.2f:%.3f cm)%s;",
		o, ascAngle, st.linhaii, ascAngle, st.linhai, nASC)
end

local function emitZodiac(buf, st)
	local p = st.params
	if not is_true(p.show_zodiac) then return end

	local showNames   = is_true(p.show_zodiac_names)
	local showSymbols = is_true(p.show_zodiac_symbols)
	local rot = st.rotationOffset

	local o = opts(width_opt(p.line_width), "draw=" .. p.line_color)

	-- Divisórias entre signos
	local dividers = {}
	for i = 0, 11 do
		local angle = i * 30 + rot
		dividers[#dividers + 1] = string.format(
			"(%.2f:%.3f cm) -- (%.2f:%.3f cm)",
			angle - 1, st.linhaiii, angle - 1, st.linhaiv)
		dividers[#dividers + 1] = string.format(
			"(%.2f:%.3f cm) -- (%.2f:%.3f cm)",
			angle + 1, st.linhaiii, angle + 1, st.linhaiv)
	end
	buf[#buf + 1] = string.format("\\draw%s %s;", o, table.concat(dividers, " "))

	-- Arcos externo/interno
	local arcs = {}
	for i = 0, 11 do
		local angle = i * 30 + rot
		arcs[#arcs + 1] = string.format(
			"(0,0) ++(%.2f:%.3f cm) arc (%.2f:%.2f:%.3f cm)",
			angle + 1, st.linhaiii, angle + 1, angle + 29, st.linhaiii)
		arcs[#arcs + 1] = string.format(
			"(0,0) ++(%.2f:%.3f cm) arc (%.2f:%.2f:%.3f cm)",
			angle + 1, st.linhaiv, angle + 1, angle + 29, st.linhaiv)
	end
	buf[#buf + 1] = string.format("\\draw%s %s;", o, table.concat(arcs, " "))

	-- Nomes dos signos
	if showNames then
		for k = 1, 12 do
			local name = escapeText(st.signNames[k] or "")
			local center = (k - 1) * 30 + rot + 15
			local arcStart = center - 14
			local arcEnd   = center + 14
			buf[#buf + 1] = string.format(
				"\\draw[decoration={text along path,"
				.. "text={|\\color{%s}\\fontsize{5}{5}\\selectfont| %s},"
				.. "text align={align=center}}, decorate]"
				.. "(%.2f:%.3f cm) arc[start angle=%.2f, end angle=%.2f, radius=%.3f cm];",
				p.zodiac_text_color, name, arcEnd, st.zodiacLabelRadius, arcEnd, arcStart,
				st.zodiacLabelRadius)
		end
	end

	-- Símbolos dos signos
	if showSymbols then
		for k = 1, 12 do
			local sym = escapeText(st.zodiacSymbols[k] or "")
			local center = (k - 1) * 30 + rot + 15
			local arcStart = center - 14
			local arcEnd   = center + 14
			buf[#buf + 1] = string.format(
				"\\draw[decoration={text along path,"
				.. "text={|\\color{%s}\\astrofont\\fontsize{5}{5}\\selectfont| %s},"
				.. "text align={align=center}}, decorate]"
				.. "(%.2f:%.3f cm) arc[start angle=%.2f, end angle=%.2f, radius=%.3f cm];",
				p.zodiac_symbol_color, sym, arcEnd, st.zodiacSymbolRadius, arcEnd, arcStart,
				st.zodiacSymbolRadius)
		end
	end
end

local function emitHouses(buf, st)
	local p = st.params
	local showHouses  = is_true(p.show_houses)
	local showNumbers = is_true(p.show_house_numbers)

	if showHouses then
		local dividers = {}
		for _, h in ipairs(st.houses) do
			local angle = h + st.rotationOffset
			dividers[#dividers + 1] = string.format(
				"(%.2f:%.3f cm) -- (%.2f:%.3f cm)",
				angle, st.linhavii, angle, st.linhaviii)
		end
		buf[#buf + 1] = string.format("\\draw%s %s;",
			opts(width_opt(p.line_width), "draw=" .. p.house_line_color),
			table.concat(dividers, " "))
	end

	if showNumbers then
		for k = 1, 12 do
			local cur = st.houses[k]
      local nxt = st.houses[k % 12 + 1]
      local mid = (cur + ((nxt - cur) % 360) / 2 + st.rotationOffset) % 360
			buf[#buf + 1] = string.format(
				"\\node[font=\\bfseries, text=%s, scale=.5, rotate=%.2f] at (%.2f:%.3f cm) {%s};",
				p.house_label_color, mid - 90, mid, st.houseLabelRadius, ROMAN[k])
		end
	end
end

local function emitPlanets(buf, st)
	local p = st.params
	local n = #st.astral
	local showTicks = is_true(p.show_planet_ticks)
	local showLinks = is_true(p.show_adjusted_links)

	-- Ticks de 1° e ticks dos corpos
	if showTicks then
		local ticks = {}
		for i = 0, 359 do
			local a = (i + st.rotationOffset) % 360
			ticks[#ticks + 1] = string.format("(%.2f:%.3f cm) -- (%.2f:%.3f cm)",
				a, st.linhav, a, st.linhavi)
		end
		buf[#buf + 1] = string.format("\\draw%s %s;",
			opts(width_opt(p.thin_line_width), "draw=" .. p.planet_tick_color),
			table.concat(ticks, " "))

		local bodyTicks = {}
		for k = 1, n do
			local raw = (st.astral[k] + st.rotationOffset) % 360
			bodyTicks[#bodyTicks + 1] = string.format(
				"(%.2f:%.3f cm)--(%.2f:%.3f cm)",
				raw, st.linhaviii, raw, st.linhaix)
		end
		buf[#buf + 1] = string.format("\\draw%s %s;",
			opts(width_opt(p.thin_line_width), "draw=" .. p.planet_tick_color),
			table.concat(bodyTicks, " "))
	end

	-- Linhas tracejadas (original → ajustada)
	if showLinks then
		local dashed = {}
		for k = 1, n do
			local raw = (st.astral[k] + st.rotationOffset) % 360
			local adj = (st.astralAdjusted[k] + st.rotationOffset) % 360
			dashed[#dashed + 1] = string.format(
				"(%.2f:%.3f cm)--(%.2f:%.3f cm)",
				adj, st.linhaxi, raw, st.linhavi)
		end
		if #dashed > 0 then
			buf[#buf + 1] = string.format("\\draw%s %s;",
				opts(width_opt(p.thin_line_width), "draw=" .. p.planet_tick_color,
					p.adjusted_dash ~= "none" and ("dash pattern=" .. p.adjusted_dash) or nil),
				table.concat(dashed, " "))
		end
	end

	-- Símbolos dos planetas (sempre)
	for k = 1, n do
		local raw = (st.astral[k] + st.rotationOffset) % 360
		local adj = (st.astralAdjusted[k] + st.rotationOffset) % 360
		local sym = escapeText(st.astralSymbols[k] or "?")
		buf[#buf + 1] = string.format(
			"\\node[font=\\astrofont, text=%s, scale=.7, rotate=%.2f] at (%.2f:%.3f cm) {%s};",
			p.planet_symbol_color, raw - 90, adj, st.linhax, sym)
	end
end

local function emitPairsAsDraws(buf, pairsStr, a, h, radius, rot, color, p)
	if not pairsStr or pairsStr == "" then return end
	local r = pairsToCoordinates(pairsStr, a, h)
	local extra = {}
	if color and color ~= "" then
    if color:find("[\\{}%[%],;%%#|=]") then fail("Cor de aspecto contem caractere reservado") end
    extra[#extra + 1] = "draw=" .. color
  end
	if p.aspect_line_width and p.aspect_line_width ~= "" then
		extra[#extra + 1] = width_opt(p.aspect_line_width)
	end
	if p.aspect_dash and p.aspect_dash ~= "none" then
		extra[#extra + 1] = "dash pattern=" .. p.aspect_dash
	end
	if p.aspect_opacity and p.aspect_opacity ~= "1" then
		extra[#extra + 1] = "opacity=" .. p.aspect_opacity
	end
	local o = opts(table.unpack(extra))
  local paths = {}
	for _, line in ipairs(r) do
		local a1 = (line[1] + rot) % 360
		local a2 = (line[2] + rot) % 360
		paths[#paths + 1] = string.format(
			"(%.2f:%.3f cm) -- (%.2f:%.3f cm)",
			a1, radius, a2, radius)
	end
  if #paths > 0 then buf[#buf+1] = "\\draw"..o.." "..table.concat(paths," ")..";" end
end

local function emitAspects(buf, st, aspectsText)
	local p = st.params
	if not is_true(p.show_aspects) then return end
	local a = st.aspectsUseAdjusted and st.astralAdjusted or st.astral
	local h = st.houses
	if aspectsText:find("(", 1, true) then
		local app, sep = parseAspectTextInternal(aspectsText)
		emitPairsAsDraws(buf, app, a, h, st.linhaix, st.rotationOffset, st.applyColor, p)
		emitPairsAsDraws(buf, sep, a, h, st.linhaix, st.rotationOffset, st.sepColor, p)
	else
		emitPairsAsDraws(buf, aspectsText, a, h, st.linhaix, st.rotationOffset, st.applyColor, p)
	end
end

-- =========================================================
-- NÚCLEOS DE RENDERIZAÇÃO
-- =========================================================

-- [v1.9.6] xshift/yshift agora também aplicados no full-page,
-- compondo com `shift={(current page.center)}`. Antes, o valor
-- era parseado mas ignorado no full-page (só inline funcionava).
local function makeScopeOpts(st, fullpage)
	local p = st.params
	local o = {}
	if fullpage then
		o[#o + 1] = "shift={(current page.center)}"
		if p.xshift and p.xshift ~= "0" then
			o[#o + 1] = "xshift=" .. p.xshift .. "cm"
		end
		if p.yshift and p.yshift ~= "0" then
			o[#o + 1] = "yshift=" .. p.yshift .. "cm"
		end
	end
	if p.scale ~= "1" then o[#o + 1] = "scale=" .. p.scale end
	return o
end

local function openScope(buf, st, fullpage)
	local o = makeScopeOpts(st, fullpage)
	if #o > 0 then
		buf[#buf + 1] = "\\begin{scope}[" .. table.concat(o, ",") .. "]"
	else
		buf[#buf + 1] = "\\begin{scope}"
	end
end

local function closeScope(buf)
	buf[#buf + 1] = "\\end{scope}"
end

-- [v1.9.3] Full-page: abre o scope, emite fill e conteúdo.
-- Os aspectos são emitidos em renderChart, entre open e close.
local function commonRender(buf, st)
	openScope(buf, st, true)
	emitZodiacFill(buf, st)
	emitConcentricCircles(buf, st)
	emitCardinalAxes(buf, st)
	emitZodiac(buf, st)
	emitHouses(buf, st)
	emitPlanets(buf, st)
end

-- [v1.9.3] Inline: abre o scope, emite fill e conteúdo.
-- `commonEnd` fecha o scope; os aspectos são emitidos entre.
-- Sem isso, o `scale` do scope não afetava os aspectos.
local function commonRenderInline(buf, st)
	openScope(buf, st, false)
	emitZodiacFill(buf, st)
	emitConcentricCircles(buf, st)
	emitCardinalAxes(buf, st)
	emitZodiac(buf, st)
	emitHouses(buf, st)
	emitPlanets(buf, st)
end

local function commonEnd(buf)
	closeScope(buf)
end

local function commonParse(planetText, houseText, radius,
                          signNamesStr, zodiacSymbolsStr, astralSymbolsStr,
                          applyColor, sepColor, aspectsUseAdjusted, cfgStr)
	local planets
	if (planetText:find(" in ", 1, true) or planetText:find(" em ", 1, true)) then
		planets = parsePlanetText(planetText)
	else
		planets = parseToTable(planetText)
		if not planets then return nil end
	end
	if #planets ~= 15 then
		fail("Esperado 15 planetas, recebido " .. #planets)
		return nil
	end

	local houses
	if (houseText:find("House", 1, true) or houseText:find("Casa", 1, true)) or houseText:find(" in ", 1, true) then
		houses = parseHouseText(houseText)
	else
		houses = parseToTable(houseText)
		if not houses then return nil end
	end
	if #houses < 12 then
		fail("Esperado pelo menos 12 casas, recebido " .. #houses)
		return nil
	end

	local r = tonumber(radius)
	if not finite(r) or r <= 0 or r > 100 then fail("Raio deve estar entre 0 e 100 cm") end
  for i,v in ipairs(planets) do if not finite(v) then fail("Planeta nao finito") end; planets[i]=v%360 end
  if #houses > 12 then warn("Cuspides extras ignoradas; usadas as primeiras 12") end
  local h = {}
  for i=1,12 do
    local v=houses[i]; if not finite(v) then fail("Casa nao finita") end
    h[i]=v%360
  end
  local span=0
  for i=1,12 do local gap=(h[i%12+1]-h[i])%360; if gap==0 then fail("Cuspides coincidentes") end; span=span+gap end
  if math.abs(span-360)>0.001 then fail("Casas fora de ordem circular") end
  houses=h

	return buildState(planets, houses, r,
		signNamesStr, zodiacSymbolsStr, astralSymbolsStr,
		applyColor, sepColor, aspectsUseAdjusted, cfgStr)
end

-- =========================================================
-- API PÚBLICA — FULL-PAGE
-- =========================================================

function M.renderChart(planetText, houseText, aspectsText, radius,
                       signNamesStr, zodiacSymbolsStr, astralSymbolsStr,
                       applyColor, sepColor, aspectsUseAdjusted, cfgStr)
	local st = commonParse(planetText, houseText, radius,
		signNamesStr, zodiacSymbolsStr, astralSymbolsStr,
		applyColor, sepColor, aspectsUseAdjusted, cfgStr)
	if not st then return end

	local buf = {}
	commonRender(buf, st)
	emitAspects(buf, st, aspectsText)
	commonEnd(buf)
	tex.sprint(table.concat(buf))
end

-- =========================================================
-- API PÚBLICA — INLINE
-- =========================================================

function M.renderChartInline(planetText, houseText, aspectsText, radius,
                             signNamesStr, zodiacSymbolsStr, astralSymbolsStr,
                             applyColor, sepColor, aspectsUseAdjusted, cfgStr)
	local st = commonParse(planetText, houseText, radius,
		signNamesStr, zodiacSymbolsStr, astralSymbolsStr,
		applyColor, sepColor, aspectsUseAdjusted, cfgStr)
	if not st then return end

	local buf = {}
	commonRenderInline(buf, st)
	emitAspects(buf, st, aspectsText)
	commonEnd(buf)
	tex.sprint(table.concat(buf))
end

-- =========================================================
-- DRY RUN — diagnóstico
-- =========================================================
function M.dryRun(planetText, houseText, aspectsText)
	local function report(label, value)
		texio.write_nl("log", "[astrocalc.dryRun] "..label..": "..tostring(value))
	end

	report("DEBUG", M.DEBUG)
	report("SEP_MIN", M.SEP_MIN)
	report("FATOR_INTENSIDADE", M.FATOR_INTENSIDADE)
	report("TOLERANCIA", M.TOLERANCIA)
	report("MAX_ITERACOES", M.MAX_ITERACOES)

	local planets
	if (planetText:find(" in ", 1, true) or planetText:find(" em ", 1, true)) then
		planets = parsePlanetText(planetText)
	else
		planets = parseToTable(planetText) or {}
	end
	report("planetas", #planets)
	if #planets ~= 15 then
		fail("dryRun: esperado 15 planetas, recebido "..#planets)
	end

	local houses
	if (houseText:find("House", 1, true) or houseText:find("Casa", 1, true)) or houseText:find(" in ", 1, true) then
		houses = parseHouseText(houseText)
	else
		houses = parseToTable(houseText) or {}
	end
	report("casas", #houses)
	if #houses < 12 then
		fail("dryRun: esperado >= 12 casas, recebido "..#houses)
	end

	if aspectsText:find("Orb:", 1, true) then
		local app, sep = parseAspectTextInternal(aspectsText)
		local n_app = 0
		for _ in app:gmatch("{") do n_app = n_app + 1 end
		local n_sep = 0
		for _ in sep:gmatch("{") do n_sep = n_sep + 1 end
		report("applying", n_app)
		report("separating", n_sep)
		report("total", n_app + n_sep)
	else
		local n = 0
		for _ in aspectsText:gmatch("{") do n = n + 1 end
		report("pares", n)
	end

	report("status", "OK (nenhum PDF gerado — apenas diagnóstico)")
end

function M.texCall(name, ...)
  local ok, err = pcall(M[name], ...)
  if not ok then
    texio.write_nl("term and log", tostring(err))
    tex.sprint("\\PackageError{astropack}{Entrada invalida; consulte o log}{Corrija os dados indicados no log.}")
  end
end

return M
end

