\newlength{\astro@radiusLen}
\def\astro@radiusRaw{0.4\paperwidth}

\newcommand{\AstroPack@ResolveRadius}[1]{%
	\IfDecimal{#1}%
	{\def\astro@radiusCM{#1}}%
	{%
		\setlength{\astro@radiusLen}{\dimexpr#1\relax}%
		\pgfmathsetmacro{\astro@radiusCM}%
		{\strip@pt\astro@radiusLen * 0.03514598035}%
	}%
}

